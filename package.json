{
  "name": "env-switch",
  "version": "1.0.0",
  "description": "ENV 配置操作工具",
  "main": "electron-main.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "electron-dev": "npm run build && electron .",
    "electron-build": "npm run build && electron-builder --win --x64",
    "electron-build-dir": "npm run build && electron-builder --dir --win",
    "electron-build-mac": "npm run build && electron-builder --mac --x64 --arm64",
    "start": "electron ."
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.0"
  },
  "build": {
    "appId": "com.envswitch.app",
    "productName": "EnvSwitch",
    "icon": "client/public/logo-1024.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/public/logo.ico",
      "artifactName": "EnvSwitch-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "client/public/logo-mac.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "client/public/logo.ico",
      "uninstallerIcon": "client/public/logo.ico"
    }
  }
}
