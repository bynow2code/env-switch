# ============================================================
# EnvSwitch .gitignore
# 应用运行数据落在 Electron userData（不在仓库内）。
# 本地依赖 / 构建产物 / 生成图标 / 环境变量 / 日志 / IDE 与系统文件均不进 git。
# （原 client/.gitignore 已合并至此，避免规则分裂。）
# ============================================================

# 依赖
node_modules/

# 构建产物（实际产物为 client/dist 与 release/；根 dist/ 仅占位）
dist/
dist-ssr/
client/dist/
release/

# 图标：由 gen-icons.js 从 logo.svg 自动生成，构建前生成，无需进 git
#      （源文件 logo.svg / logo-mac.svg / favicon.svg 必须进 git，仅忽略生成的 png/ico）
client/public/*.png
client/public/*.ico

# 环境变量
.env
.env.local
*.local

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
