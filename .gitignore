node_modules/
dist/
client/dist/
release/
# 由 gen-icons.js 从 logo.svg 自动生成（构建前由 electron-* script 生成，无需进 git）。
# 注意：源文件 logo.svg 与 favicon.svg 都不在此忽略范围内，必须进 git；
#       只有下面生成的 png/ico 才被忽略。
client/public/*.png
client/public/*.ico

# 本地数据文件（包含用户个人项目路径）
# 覆盖主数据文件 + 任何备份/迁移遗留（如 server/data.json.bak.YYYY-MM-DD）
# 注意：通配符用 `data.json*` 而非 `data*.json`——git 的 fnmatch `*` 不能跨第二个扩展名，
# 后者无法匹配 `data.json.bak.2026-07-29`（.json 后面还有 .bak）
server/data.json*

# server 运行日志（每次启动追加，本地诊断用，不应进版本控制）
server/logs/

# 环境变量
.env
.env.local

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db